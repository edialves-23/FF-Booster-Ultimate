
<Window x:Class="FFBoosterUltimate.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FF BOOSTER ULTIMATE"
 Height="720" Width="1000"
 MinHeight="650" MinWidth="850"
 WindowStartupLocation="CenterScreen"
 Background="#101014"
 Foreground="White">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#303038"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="FF BOOSTER ULTIMATE"
                       FontSize="30"
                       FontWeight="Black"
                       Foreground="#F02D3A"/>
            <TextBlock Text="MAX PERFORMANCE • GAMING EDITION"
                       Foreground="#9999A5"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1B1B22"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="STATUS DO SISTEMA"
                           Foreground="#AAAAAA"/>
                <TextBlock x:Name="StatusText"
                           Text="AGUARDANDO"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF6872"/>
                <TextBlock x:Name="GameStatus"
                           Text="Procurando BlueStacks..."
                           Foreground="#AAAAAA"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Background="#1B1B22"
                    CornerRadius="12"
                    Margin="5" Padding="18">
                <StackPanel>
                    <TextBlock Text="CPU • i5-10400F"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="CpuValue"
                               Text="0%"
                               FontSize="32"
                               Foreground="#F02D3A"
                               Margin="0,8"/>
                    <ProgressBar x:Name="CpuBar"
                                 Height="12"
                                 Maximum="100"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    Background="#1B1B22"
                    CornerRadius="12"
                    Margin="5" Padding="18">
                <StackPanel>
                    <TextBlock Text="RAM • 16 GB"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="RamValue"
                               Text="0%"
                               FontSize="32"
                               Foreground="#F02D3A"
                               Margin="0,8"/>
                    <ProgressBar x:Name="RamBar"
                                 Height="12"
                                 Maximum="100"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0"
                    Background="#1B1B22"
                    CornerRadius="12"
                    Margin="5" Padding="18">
                <StackPanel>
                    <TextBlock Text="GPU • GTX 1060"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="GpuValue"
                               Text="--"
                               FontSize="28"
                               Foreground="#F02D3A"
                               Margin="0,8"/>
                    <TextBlock x:Name="GpuDetail"
                               Text="Aguardando NVIDIA"
                               Foreground="#AAAAAA"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1"
                    Background="#1B1B22"
                    CornerRadius="12"
                    Margin="5" Padding="18">
                <StackPanel>
                    <TextBlock Text="BLUESTACKS"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="PlayerValue"
                               Text="OFFLINE"
                               FontSize="28"
                               Foreground="#F02D3A"
                               Margin="0,8"/>
                    <TextBlock x:Name="PriorityValue"
                               Text="Prioridade: --"
                               Foreground="#AAAAAA"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    Background="#1B1B22"
                    CornerRadius="12"
                    Padding="18" Margin="5">
                <StackPanel>
                    <TextBlock Text="CONTROLE DE DESEMPENHO"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <WrapPanel>
                        <Button x:Name="StartButton"
                                Content="⚡ START BOOST"
                                Background="#C91F2C"
                                Click="StartButton_Click"/>

                        <Button x:Name="StopButton"
                                Content="■ STOP / RESTAURAR"
                                IsEnabled="False"
                                Click="StopButton_Click"/>

                        <Button Content="↻ ATUALIZAR"
                                Click="RefreshButton_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="LogText"
                               Text="Sistema pronto."
                               Foreground="#AAAAAA"
                               Margin="5,15,5,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="FF BOOSTER ULTIMATE • WINDOWS • .NET 8"
                   Foreground="#666670"
                   HorizontalAlignment="Center"
                   Margin="0,12"/>
    </Grid>
</Window>
